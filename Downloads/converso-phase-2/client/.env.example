# Base URL for API calls. The Vite dev server proxies /api to http://localhost:5000.
VITE_API_URL=/api/v1

# Firebase web app config (Firebase console > Project settings > General > Your apps).
# See README > Firebase setup for exactly where to find these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Added in a later phase (not read yet) ----
# Phase 5: Razorpay (public key only)
# VITE_RAZORPAY_KEY_ID=
