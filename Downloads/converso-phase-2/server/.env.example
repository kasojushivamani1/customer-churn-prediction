# ---- Core (required) ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/converso
CLIENT_URL=http://localhost:5173

# Platform commission taken from each completed booking, as a percentage (0-100).
# Decided rate: the platform keeps 40, the Practice Partner keeps the remaining 60.
# This is the ONLY place the split is set - see src/services/pricing.service.js,
# which reads it rather than hard-coding 40/60, so changing the rate later never
# means hunting through the codebase.
PLATFORM_COMMISSION_PERCENT=40

# Which video provider adapter to use (see src/services/video).
VIDEO_PROVIDER=daily

# ---- Firebase Admin (required from Phase 2 on) ----
# From a service account JSON (Firebase console > Project settings > Service accounts >
# Generate new private key). See README > Firebase setup.
# FIREBASE_PRIVATE_KEY must be one line: keep the \n sequences literal and wrap the
# whole value in quotes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END...-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Added in a later phase (not read yet) ----
# Phase 5: Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Phase 6: Daily.co
# DAILY_API_KEY=
